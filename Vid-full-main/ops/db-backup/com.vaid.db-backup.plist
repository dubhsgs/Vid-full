<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vaid.db-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yan/Library/Application Support/VAID/db-backup/local-encrypted-db-backup.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>VAID_BACKUP_ROOT</key>
    <string>/Users/yan/Library/Application Support/VAID/backups</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/yan/Library/Logs/VAID/db-backup.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/yan/Library/Logs/VAID/db-backup.err</string>
</dict>
</plist>
